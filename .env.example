# Serveur
PORT=4000
NODE_ENV=development

# URL publique de l'API (utilisee dans les liens de verification d'email envoyes par mail)
API_PUBLIC_URL=http://localhost:4000

# Base de donnees (Supabase - PostgreSQL)
# DATABASE_URL : connexion "pooled" via PgBouncer (port 6543) - utilisee par l'app au quotidien
# DIRECT_URL   : connexion directe (port 5432) - utilisee uniquement par Prisma pour les migrations
# Les deux se trouvent dans Supabase > Project Settings > Database > Connection string
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:VOTRE_MOT_DE_PASSE@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:VOTRE_MOT_DE_PASSE@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Auth
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Stockage fichiers (CV, logos, documents)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# IA (analyse CV, generation de questions d'entretien)
AI_API_KEY=
AI_API_URL=https://api.anthropic.com/v1/messages

# Email (verification de compte, mot de passe oublie, notifications d'alertes)
# Compatible avec n'importe quel fournisseur SMTP : Gmail, Brevo, SendGrid, Mailtrap...
# Laisser vide desactive l'envoi reel (les emails sont juste logges dans la console).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Carrière+ <no-reply@carriereplus.app>"

# Notifications push (Firebase Cloud Messaging)
# Cree un projet sur https://console.firebase.google.com, active Cloud Messaging,
# puis Parametres du projet > Comptes de service > Generer une nouvelle cle privee.
# Laisser vide desactive les notifications push (aucune erreur, juste ignorees).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
